/target
**/*.rs.bk
Cargo.lock.orig
.DS_Store
*.db
*.db-wal
*.db-shm
.serena/
# fastembed ONNX model cache (created by rb-eval recording / rb-embed local smoke tests)
.fastembed_cache/
# Claude Code personal/local settings override (never committed; the committed
# .claude/settings.json is the shared rusty-brain dogfood config / reference template).
.claude/settings.local.json
.worktrees
# Cross-agent fixture recorder home (scripts/record-agent-fixtures.sh). The
# STABLE recorder home normally lives OUTSIDE the repo at
# ${XDG_CACHE_HOME:-$HOME/.cache}/rusty-brain/fixture-record/<agent>/ and holds a
# read-only COPY of the operator's auth + per-agent session history. Defense in
# depth: if XDG_CACHE_HOME ever points inside the repo, never let it be committed.
**/rusty-brain/fixture-record/
.cache/
