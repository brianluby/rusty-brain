+/// What the local cache holds of a pinned revision, per [`cached_pin_status`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PinCacheStatus {
+    /// Every pinned file is cached with the expected hash.
+    Complete,
+    /// These files are absent (in pin order); loading would download them.
+    Missing(Vec<&'static str>),
+    /// This cached file's SHA-256 differs from the pin; loading would refuse it.
+    Corrupt { file: &'static str },
+}
+
+/// Check, fully offline, whether `cache_root` holds every file of `pin` at its
+/// revision in hf-hub's layout. Never downloads, creates or modifies anything.
+/// A hash mismatch wins over missing files, so a corrupt cache is never
+/// reported as merely incomplete.
+pub fn cached_pin_status(cache_root: &Path, pin: &PinnedModel) -> rb_types::Result<PinCacheStatus> {
+    let snapshot = cache_root
+        .join(format!("models--{}", pin.repo.replace('/', "--")))
+        .join("snapshots")
+        .join(pin.revision);
+    let mut missing = Vec::new();
+    for file in [
+        &pin.onnx,
+        &pin.tokenizer,
+        &pin.config,
+        &pin.special_tokens_map,
+        &pin.tokenizer_config,
+    ] {
+        let path = snapshot.join(file.name);
+        // Follows hf-hub's symlinks into `blobs/`; a dangling one is missing.
+        let mut reader = match std::fs::File::open(&path) {
+            Ok(f) => f,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+                missing.push(file.name);
+                continue;
+            }
+            Err(e) => {
+                return Err(Error::Embedding(format!(
+                    "failed to open {}: {e}",
+                    path.display()
+                )))
+            }
+        };
+        // Stream: model.onnx is ~90 MB.
+        let mut hasher = Sha256::new();
+        std::io::copy(&mut reader, &mut hasher)
+            .map_err(|e| Error::Embedding(format!("failed to read {}: {e}", path.display())))?;
+        if format!("{:x}", hasher.finalize()) != file.sha256 {
+            return Ok(PinCacheStatus::Corrupt { file: file.name });
+        }
+    }
+    Ok(if missing.is_empty() {
+        PinCacheStatus::Complete
+    } else {
+        PinCacheStatus::Missing(missing)
+    })
+}
