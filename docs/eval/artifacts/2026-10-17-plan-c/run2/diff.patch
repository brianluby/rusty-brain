+/// Local backend only: is the pinned model fully and intactly cached? Purely
+/// offline — inspects `cache_root` without downloading or writing, so a
+/// corrupt cache is caught before the daemon refuses to load it.
+#[cfg(feature = "local")]
+pub fn check_local_model_cache(cache_root: &Path, local_model: Option<&str>) -> DoctorCheck {
+    let name = "local-model-cache";
+    let pin = match rb_embed::pinned_model(local_model.unwrap_or_default()) {
+        Ok(pin) => pin,
+        Err(e) => {
+            return DoctorCheck {
+                name,
+                status: CheckStatus::Fail,
+                detail: e.to_string(),
+                hint: None,
+            }
+        }
+    };
+    local_model_cache_check(
+        cache_root,
+        pin,
+        rb_embed::cached_pin_status(cache_root, pin),
+    )
+}
+
+/// Map a cache inspection result to the `local-model-cache` check.
+#[cfg(feature = "local")]
+fn local_model_cache_check(
+    cache_root: &Path,
+    pin: &rb_embed::PinnedModel,
+    status: rb_types::Result<rb_embed::PinCacheStatus>,
+) -> DoctorCheck {
+    let name = "local-model-cache";
+    let model = format!("{}@{}", pin.repo, pin.revision);
+    match status {
+        Ok(rb_embed::PinCacheStatus::Complete) => DoctorCheck {
+            name,
+            status: CheckStatus::Ok,
+            detail: format!("{model} cached in {}", cache_root.display()),
+            hint: None,
+        },
+        Ok(rb_embed::PinCacheStatus::Missing(files)) => DoctorCheck {
+            name,
+            status: CheckStatus::Warn,
+            detail: format!(
+                "{model} is not fully cached in {} (missing {})",
+                cache_root.display(),
+                files.join(", ")
+            ),
+            hint: Some(
+                "the first daemon start downloads it (needs network access to \
+                 the Hugging Face endpoint)"
+                    .to_string(),
+            ),
+        },
+        Ok(rb_embed::PinCacheStatus::Corrupt { file }) => DoctorCheck {
+            name,
+            status: CheckStatus::Fail,
+            detail: format!(
+                "cached {file} of {model} in {} does not match its pinned SHA-256; \
+                 the daemon will refuse to load it",
+                cache_root.display()
+            ),
+            hint: Some(format!(
+                "delete {} so the next daemon start re-downloads it",
+                cache_root
+                    .join(format!("models--{}", pin.repo.replace('/', "--")))
+                    .display()
+            )),
+        },
+        Err(e) => DoctorCheck {
+            name,
+            status: CheckStatus::Fail,
+            detail: format!("cannot inspect {model} in {}: {e}", cache_root.display()),
+            hint: None,
+        },
+    }
+}
