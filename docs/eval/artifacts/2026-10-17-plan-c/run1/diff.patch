+        ids[3] = b.clone();
+        ids[IN_LIST_CHUNK + 7] = foreign;
+        ids[25_000] = a.clone();
+        ids[39_999] = b.clone();
+
+        let got: Vec<MemoryId> = store
+            .get_many(&proj, &ids)
+            .unwrap()
