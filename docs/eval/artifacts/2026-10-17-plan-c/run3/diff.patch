+        assert_eq!(mode_of(&dir.path().join("x")), 0o700);
+        assert_eq!(mode_of(&dir.path().join("x/y")), 0o700);
+        assert_no_staging_leftovers(dir.path());
+        assert_no_staging_leftovers(&dir.path().join("x"));
