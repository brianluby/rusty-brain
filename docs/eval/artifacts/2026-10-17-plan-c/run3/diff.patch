+/// Validate an existing socket dir from its `lstat` metadata, never repairing.
+fn check_socket_dir(dir: &Path, metadata: &fs::Metadata) -> Result<()> {
+    use std::os::unix::fs::MetadataExt;
+
+    if metadata.file_type().is_symlink() {
+        return Err(Error::Io(format!(
+            "socket parent {} is a symlink; refusing to follow it",
+            dir.display()
+        )));
+    }
+    if !metadata.is_dir() {
+        return Err(Error::Io(format!(
+            "socket parent {} is not a directory",
+            dir.display()
+        )));
+    }
+    let euid = process_euid();
+    if metadata.uid() != euid {
+        return Err(Error::Io(format!(
+            "socket dir {} is owned by uid {}, not the current user (uid {euid})",
+            dir.display(),
+            metadata.uid()
+        )));
+    }
+    let mode = metadata.permissions().mode() & 0o7777;
+    if mode != 0o700 {
+        return Err(Error::Io(format!(
+            "socket dir {} must already be private (0700), got {mode:03o}",
+            dir.display()
+        )));
+    }
+    Ok(())
+}
+
+/// Create `dir` and any missing ancestors as exactly 0700. Each new component
+/// is built as a private staging dir, chmodded past the umask, then published
+/// with a no-replace rename, so no observer sees it with any other mode. Fails
+/// with `AlreadyExists` when `dir` itself appeared concurrently.
+fn create_private_dir_atomically(dir: &Path) -> std::io::Result<()> {
+    use std::io::ErrorKind;
+    use std::os::unix::fs::DirBuilderExt as _;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static STAGING_SEQ: AtomicU64 = AtomicU64::new(0);
+
+    let parent = match dir.parent() {
+        Some(parent) if !parent.as_os_str().is_empty() => parent,
+        Some(_) => Path::new("."),
+        None => return Err(ErrorKind::AlreadyExists.into()),
+    };
+    match fs::symlink_metadata(parent) {
+        Ok(_) => {}
+        Err(e) if e.kind() == ErrorKind::NotFound => match create_private_dir_atomically(parent) {
+            Ok(()) => {}
+            Err(e) if e.kind() == ErrorKind::AlreadyExists => {}
+            Err(e) => return Err(e),
+        },
+        Err(e) => return Err(e),
+    }
+
+    let nanos = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.subsec_nanos());
+    for _ in 0..16 {
+        let staging = parent.join(format!(
+            ".rb-private-dir-{}-{}-{nanos}",
+            std::process::id(),
+            STAGING_SEQ.fetch_add(1, Ordering::Relaxed)
+        ));
+        match fs::DirBuilder::new().mode(0o700).create(&staging) {
+            Ok(()) => {}
+            // A stale or planted staging name: try the next one.
+            Err(e) if e.kind() == ErrorKind::AlreadyExists => continue,
+            Err(e) => return Err(e),
+        }
+        let published = fs::set_permissions(&staging, fs::Permissions::from_mode(0o700))
+            .and_then(|()| rename_noreplace(&staging, dir));
+        if published.is_err() {
+            let _ = fs::remove_dir(&staging);
+        }
+        return published;
+    }
+    Err(std::io::Error::other(format!(
+        "no free staging dir name in {}",
+        parent.display()
+    )))
+}
